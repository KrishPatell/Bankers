{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bankersvascular",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "vars": {
    "CONTACT_TO_EMAIL": "support@bng.thinkowl.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
