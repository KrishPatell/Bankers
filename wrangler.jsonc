{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bankersvascular",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "vars": {
    "CONTACT_TO_EMAIL": "support@bng.thinkowl.com",
    "CONTACT_FROM_EMAIL": "Bankers Vascular Centre <noreply@bankersvascular.com>"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "YOUTUBE_CACHE",
      "id": "REPLACE_WITH_YOUTUBE_CACHE_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
